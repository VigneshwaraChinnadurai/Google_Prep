# Environment variables for ApplyFast
# Copy this to .env and fill in your values

# Google Gemini API key (required for AI tailoring)
GOOGLE_API_KEY=your_google_api_key_here

# App password for login (default: applyfast)
APP_PASSWORD=applyfast

# Session secret
SESSION_SECRET=change-this-to-a-random-string

# Server port
PORT=8080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
